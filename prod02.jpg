<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Login — Heritage By Aemli</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/style.css" />
</head>
<body data-page="login">
<a class="skip" href="#main">Skip to content</a>
<div id="siteHeader"></div>

<main id="main">
  <div class="auth-wrap">
    <div class="auth-card">
      <h1>Welcome Back</h1>
      <p class="sub">Sign in to your Heritage By Aemli account</p>
      <form id="loginForm" novalidate>
        <div class="field"><label>Email</label><input type="email" id="email" required placeholder="you@example.com"></div>
        <div class="field"><label>Password</label><input type="password" id="password" required placeholder="••••••••"></div>
        <button class="btn btn-primary btn-block" type="submit">Sign In</button>
      </form>
      <div class="auth-msg" id="msg"></div>
      <div class="auth-alt">New here? <a href="register.html">Create an account</a></div>
    </div>
  </div>
</main>

<div id="siteFooter"></div>

<script src="js/data.js"></script>
<script src="js/store.js"></script>
<script src="js/ui.js"></script>
<script>
  document.getElementById('loginForm').addEventListener('submit',e=>{
    e.preventDefault();
    const msg=document.getElementById('msg'); msg.className='auth-msg';
    const r=window.Store.login(document.getElementById('email').value, document.getElementById('password').value);
    if(r.ok){ AEMLI_UI.toast('Signed in ✿'); window.location.href='account.html'; }
    else { msg.textContent=r.msg; msg.classList.add('err'); }
  });
</script>
</body>
</html>
